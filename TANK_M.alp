	<JavaClasses>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1777272882096</Id>
			<Name><![CDATA[IShiftDependent]]></Name>
			<Text><![CDATA[/**
 * Интерфейс для объектов, поведение которых зависит от текущей смены
 */
public interface IShiftDependent {
    double getProductivityFactor(); // Коэффициент альфа
    double getHourlyBonus();        // Доплата за смену
    boolean isOperationAllowed();   // Разрешена ли операция (например, испытания ночью)
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1777272967186</Id>
			<Name><![CDATA[ShiftManager]]></Name>
			<Text><![CDATA[public class ShiftManager {
    public enum ShiftType { dayShift, eveningShift, nightShift }
    public ShiftType currentShift = ShiftType.dayShift;
    
    private Main main;

    public ShiftManager(Main mainObject) {
        this.main = mainObject;
    }

    public double getAlpha() {
    	// Коэффициент потери времени на регламентированную пересменку (15 минут из 8 часов)
        double handoverPenalty = 7.75 / 8.0; 
        
        switch(currentShift) {
            case dayShift:     return 1.00 * handoverPenalty;
            case eveningShift: return 0.90 * handoverPenalty;
            case nightShift:   return 0.85 * handoverPenalty;
            default:           return 1.00 * handoverPenalty;
        }
    }

    public double getCrossoverTime() {
        return main.triangular(0.17, 0.25, 0.33); 
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1777273129188</Id>
			<Name><![CDATA[FinancialController]]></Name>
			<Text><![CDATA[public class FinancialController {
    public double totalNPV = 0;
    public double revenueCount = 0;
    
    // Параметры из Танк-М 
    private final double PRICE_PER_REPAIR = 85000.0;
    private final double VAR_COSTS = 40000.0;
    private final double FIXED_COSTS_MONTH = 400000.0;

    public void onRepairFinished(RepairOrder order) {
        revenueCount += PRICE_PER_REPAIR;
        double profit = PRICE_PER_REPAIR - VAR_COSTS;
        totalNPV += profit;
        // Здесь будет логика дисконтирования по ставке 15% (наверное)
    }
    
    // Расчет ФОТ с учетом доплат +20% и +40% 
    public double calculateLaborCost(int staffCount, ShiftManager.ShiftType shift) {
        double baseRate = 500.0; // Примерная ставка
        if (shift == ShiftManager.ShiftType.eveningShift) return baseRate * 1.2;
        if (shift == ShiftManager.ShiftType.nightShift) return baseRate * 1.4;
        return baseRate;
    }
}]]></Text>
		</JavaClass>
	</JavaClasses>
